{
  "name": "ai-switch-cli",
  "version": "0.1.2",
  "description": "Universal CLI to switch between AI dev tools and providers",
  "license": "MIT",
  "author": "Danilo Saiter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Niliotiii/ai-switch-cli.git"
  },
  "homepage": "https://github.com/Niliotiii/ai-switch-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "ai",
    "switch",
    "provider",
    "claude",
    "opencode"
  ],
  "type": "module",
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "ai-switch": "bin/ai-switch.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^5.3.8",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsup": "^8.2.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/Niliotiii/ai-switch-cli/issues"
  }
}
